# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (host-side tools connect on 5433; containers use the internal 'postgres:5432' host)
DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse

# Auth (access tokens are JWTs; refresh tokens are opaque, so only one secret is needed)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Monitoring engine
CHECK_CONCURRENCY=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# CORS (comma separated origins)
CORS_ORIGIN=http://localhost:5173

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs, or a preset
# like 'loopback'). Empty = ignore the header; the rate limiter keys on the socket address.
TRUST_PROXY=
